// Bracket from STEP (geo/step/bracket.step -> step_auto.py exact layout -> face_ids.py):
// wide end clamped by CAD face, five load cases on one LU, all placed by CAD face or by a
// box that cuts through patches. Units: mm, N, MPa (PLA-like material).
// Faces (python/face_ids.py): 1 top, 13 bottom, 6 end x = -1.5, 7 end x = +1.5, 12 hole.
// Graded towards the clamp (face 6) and through the clamp's thickness (towards faces 1, 13), by
// knot insertion (python/grade_dat.py): bending closes equilibrium to 0.5 % instead of 15 %.
// "cache": "none": at 11k unknowns the operator file (2 GB) loads slower than it assembles.
{
  "geometry": "../geo/step/bracket_exact_p3_h0.7_c3.dat",
  "grade": {"faces": [6], "inner": [1, 13], "h0": 0.025},
  "cache": "none",
  "material": {"E": 3500, "nu": 0.36},
  "supports": [
    {"label": "clamp", "face_id": 6, "fix": ["ux", "uy", "uz"]}
  ],
  "cases": [
    {"name": "pull",  "loads": [{"label": "end force", "face_id": 7, "force_N": 10, "direction": [1, 0, 0]}]},
    {"name": "bend",  "loads": [{"label": "end force", "face_id": 7, "force_N": 1, "direction": [0, 0, -1]}]},
    {"name": "twist", "loads": [{"label": "end torque", "face_id": 7, "moment": [0.5, 0, 0]}]},
    {"name": "press", "loads": [{"label": "pad pressure", "select": {"box": [[0.6, -0.15, 0.09], [1.2, 0.15, 0.11]]}, "pressure": 20}]},
    {"name": "pin",   "loads": [{"label": "pin bearing", "face_id": 12, "bearing": {"force_N": 10, "direction": [1, 0, 0]}}]}
  ],
  "output": {"vtu": "results/bc_bracket_clamped_graded", "csv": "results/bc_bracket_clamped_graded.csv"}
}
