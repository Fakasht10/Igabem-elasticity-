---
 models/crack_field/model.py      |  15 +-
 models/crack_field/transfer.json | 897 +++++++++++++++++++++++++++++++
 models/crack_field/transfer.py   |  83 +++
 3 files changed, 993 insertions(+), 2 deletions(-)
 create mode 100644 models/crack_field/transfer.json
 create mode 100644 models/crack_field/transfer.py

diff --git a/models/crack_field/model.py b/models/crack_field/model.py
index cbf0b33..d2517ad 100644
--- a/models/crack_field/model.py
+++ b/models/crack_field/model.py
@@ -142,6 +142,13 @@ MODELS = {
         amap=a_sat(A_CAP),
         bounds=dict(a0=(0, 5.5), kap=(0, 60), n=(0, 5)),
     ),
+    "ys-net": dict(  # reference: net stress + Walker + uniform infill knock-down phi^-n
+        source="YS2025",
+        extra=["n"],
+        starts=[[0.7], [0.2]],
+        net=True,
+        bounds=dict(n=(0, 5)),
+    ),
     "ys-sat-fit": dict(
         source="YS2025",
         extra=["a0", "kap", "n", "acap"],
@@ -181,8 +188,12 @@ def F_rows(m: dict, d: Data, p: dict) -> np.ndarray:
     fd = fields(d.source)
     if d.source == "ES2020":
         u = [F_es(fd, g, p["a0"]) for g, _, _ in d.ukeys]
+    elif m.get("net"):
+        u = [ph ** -p["n"] for _, _, ph in d.ukeys]
     else:
-        u = [F_ys(fd, g, m["amap"](p, dv), ph, p["n"]) for g, dv, ph in d.ukeys]
+        u = [
+            F_ys(fd, g, m["amap"](p, dv), ph, p.get("n", 0.0)) for g, dv, ph in d.ukeys
+        ]
     return np.asarray(u)[d.inv]
 
 
@@ -309,7 +320,7 @@ def run(name: str, par: dict | None = None) -> dict:
         pred_life=pr["pred_life"],
     )
     res.update(own=own_stats(pr, res["par"]), bench=rep)
-    if d.source == "YS2025":
+    if "amap" in m:
         a = [m["amap"](res["par"], v) for v in (d.dv[d.fit].max(), d.dv.max())]
         res.update(
             a_max_fit=a[0],
