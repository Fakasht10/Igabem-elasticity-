+"""Leave-one-infill-level-out transfer test (YS2025): physics, or a fit to one level.
+
+For each infill level k: calibrate on plain + V at the OTHER four levels (paper split FIT ids minus level k), then
+predict every specimen at level k (plain, V and the U notches, none of which were seen). Residual = log10(S_pred/S_exp)
+on failures (stress) and log10(N_exp/N_pred) (life). Models: ys-net (net stress + Walker + phi^-n, the reference),
+ys-lin (a = a0 + kap d_V), ys-sat (saturating, a_cap 2.1 mm fixed a priori).
+
+    python -m models.crack_field.transfer            # ~1 min, writes transfer.json next to this file
+"""
+
+import json
+import math
+from pathlib import Path
+
+import numpy as np
+
+from . import model as M
+
+LEVELS = (100, 80, 60, 40, 20)
+NAMES = ("ys-net", "ys-lin", "ys-sat")
+
+
+def residuals(name: str, p: dict, d: M.Data) -> tuple[np.ndarray, np.ndarray]:
+    """Stress and life residuals (log10) of every row."""
+    c = M.lnc(d, p, M.F_rows(M.MODELS[name], d, p))
+    return (c - d.lnN) / (p["k"] * math.log(10)), (d.lnN - c) / math.log(10)
+
+
+def rms(x: np.ndarray) -> float:
+    """Root mean square (nan if empty)."""
+    return float(np.sqrt(np.mean(x**2))) if len(x) else float("nan")
+
+
+def run() -> dict:
+    """All folds, all models; per held level: rms and bias by geometry group."""
+    out = {}
+    for name in NAMES:
+        d = M.Data("YS2025")
+        base_fit = d.fit.copy()
+        full = M.fit(name, d)
+        rs_full, rn_full = residuals(name, full["par"], d)
+        res = {"full_fit": dict(aic=full["aic"], par=full["par"]), "folds": {}}
+        for lv in LEVELS:
+            lvl = np.isclose(d.phi, lv / 100)
+            d.fit = base_fit & ~lvl
+            o = M.fit(name, d)
+            d.fit = base_fit
+            rs, rn = residuals(name, o["par"], d)
+            f = {"par": o["par"], "on_bound": o["on_bound"]}
+            for grp, gm in (
+                ("U", np.isin(d.g, ("U_r1", "U_r3"))),
+                ("V", d.g == "V_r0.15"),
+                ("UV", d.g != "plain"),
+                ("plain", d.g == "plain"),
+                ("all", np.ones(len(d.g), bool)),
+            ):
+                m = lvl & gm & ~d.ro
+                f[grp] = dict(
+                    n=int(m.sum()),
+                    rms_S=rms(rs[m]),
+                    bias_S=float(rs[m].mean()),
+                    rms_N=rms(rn[m]),
+                    bias_N=float(rn[m].mean()),
+                    rms_S_infit=rms(rs_full[m]),
+                    rms_N_infit=rms(rn_full[m]),
+                )
+            res["folds"][lv] = f
+            u = f["U"]
+            print(
+                f"{name:7s} hold {lv:3d}%  U rms S {u['rms_S']:.3f} (all-level fit "
+                f"{u['rms_S_infit']:.3f}) bias {u['bias_S']:+.3f} | V {f['V']['rms_S']:.3f} "
+                f"| plain {f['plain']['rms_S']:.3f} | U+V life {f['UV']['rms_N']:.2f} "
+                f"| par { {k: round(v, 2) for k, v in o['par'].items() if k not in M.CORE} } "
+                f"bound {o['on_bound']}",
+                flush=True,
+            )
+        out[name] = res
+    Path(__file__).with_name("transfer.json").write_text(json.dumps(out, indent=1))
+    return out
+
+
+if __name__ == "__main__":
+    run()
