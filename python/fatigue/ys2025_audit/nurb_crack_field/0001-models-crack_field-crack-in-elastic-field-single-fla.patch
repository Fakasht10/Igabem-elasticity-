+"""Run: python -m models.crack_field {es|ys-lin|ys-sat|ys-sat-fit|all} [--check] [--stored] [--write].
+
+Fits the model on the split's FIT ids, predicts every row, scores with calibration.pla_fatigue.score and prints the
+benchmark report plus the life-residual statistics. --stored skips the fit and uses expected.json's parameters (seconds).
+--check compares the result with expected.json and exits non-zero on any difference beyond its tolerance.
+"""
+
+import json
+import sys
+import time
+from pathlib import Path
+
+from calibration import pla_fatigue as B
+
+from . import model as M
+
+EXP = Path(__file__).with_name("expected.json")
+TOL = dict(aic=0.05, par=0.02, rms=2e-3)
+
+
+def headline(res: dict) -> dict:
+    """Headline numbers of one run (what expected.json stores)."""
+    b, o = res["bench"], res["own"]
+    return dict(
+        aic=res.get("aic"),
+        par=res["par"],
+        held_rms_logS=b["held"]["rms"],
+        fit_rms_logS=b["fit"]["rms"],
+        held_net_stress_rms_logS=b["held_net_stress"]["rms"],
+        held_vs_net=b["held_vs_net_stress"],
+        held_rms_logN=o["held"]["rms_logN"],
+        fit_rms_logN=o["fit"]["rms_logN"],
+        own=o,
+        on_bound=res.get("on_bound"),
+        wall_gap=res.get("wall_gap"),
+    )
+
+
+def check(name: str, h: dict, e: dict) -> bool:
+    """Compare a run with expected.json within TOL; print PASS or the differences."""
+    bad = []
+    if h["aic"] is not None and abs(h["aic"] - e["aic"]) > TOL["aic"]:
+        bad.append(f"aic {h['aic']:.3f} vs {e['aic']:.3f}")
+    for k, v in e["par"].items():
+        if abs(h["par"][k] - v) > TOL["par"] * max(1, abs(v)):
+            bad.append(f"{k} {h['par'][k]:.4f} vs {v:.4f}")
+    for k in ("held_rms_logS", "fit_rms_logS", "held_rms_logN", "fit_rms_logN"):
+        if abs(h[k] - e[k]) > TOL["rms"] * (5 if "logN" in k else 1):
+            bad.append(f"{k} {h[k]:.4f} vs {e[k]:.4f}")
+    if h["on_bound"]:
+        bad.append(f"on bound {h['on_bound']}")
+    print(f"CHECK {name}: " + ("PASS" if not bad else "FAIL " + "; ".join(bad)))
+    return not bad
+
+
+def main(argv: list[str]) -> int:
+    """Run the named models (or all), print the reports, optionally --check / --write."""
+    names = [a for a in argv if not a.startswith("--")] or ["all"]
+    names = list(M.MODELS) if names == ["all"] else names
+    exp = json.loads(EXP.read_text()) if EXP.exists() else {}
+    ok, out = True, {}
+    for n in names:
+        t = time.time()
+        res = M.run(n, par=exp[n]["par"] if "--stored" in argv else None)
+        if "--stored" in argv:
+            res["aic"], res["on_bound"] = None, []
+        h = out[n] = headline(res)
+        print(
+            f"\n### {n}  ({time.time() - t:.0f} s)  AIC {h['aic'] if h['aic'] is None else round(h['aic'], 2)}  "
+            f"params { ({k: round(v, 4) for k, v in h['par'].items()}) }  on bound {h['on_bound']}"
+            + (
+                f"  wall gap {h['wall_gap']:.2f} mm"
+                if h["wall_gap"] is not None
+                else ""
+            )
+        )
+        print(B.report_text(res["bench"]))
+        for part in ("fit", "held"):
+            s = h["own"][part]
+            print(
+                f"  life residual {part:4s}: n {s['n']}, rms {s['rms_logN']:.3f}, bias {s['bias_logN']:+.3f}, tilt vs N_exp "
+                f"{s['tilt_vs_Nexp']:+.3f}, vs N_pred {s['tilt_vs_Npred']:+.3f}, P10-P90 coverage {100 * s['coverage80']:.0f} %"
+            )
+        if "U1_minus_U3_logN" in h["own"]:
+            print(
+                f"  U r1 - U r3 mean life residual {h['own']['U1_minus_U3_logN']:+.3f} decades"
+            )
+        if "--check" in argv:
+            ok &= check(n, h, exp[n])
+    if "--write" in argv:
+        EXP.write_text(json.dumps({**exp, **out}, indent=1))
+    return 0 if ok else 1
+
+
+sys.exit(main(sys.argv[1:]))
