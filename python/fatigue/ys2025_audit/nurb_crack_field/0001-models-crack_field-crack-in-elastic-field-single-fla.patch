+"""Crack-in-elastic-field model (models/crack_field): reproduce the headline numbers of expected.json from a clean clone."""
+
+import json
+from pathlib import Path
+
+import pytest
+
+from models.crack_field import model as M
+
+EXP = json.loads(
+    (
+        Path(__file__).resolve().parents[1] / "models" / "crack_field" / "expected.json"
+    ).read_text()
+)
+
+
+@pytest.mark.parametrize("name", list(M.MODELS))
+def test_stored_parameters_score(name):
+    """Stored optimum -> benchmark scorer: held/fit stress rms and life rms as published in the README."""
+    e = EXP[name]
+    r = M.run(name, par=e["par"])
+    assert r["bench"]["held"]["rms"] == pytest.approx(e["held_rms_logS"], abs=1e-4)
+    assert r["bench"]["fit"]["rms"] == pytest.approx(e["fit_rms_logS"], abs=1e-4)
+    assert r["own"]["held"]["rms_logN"] == pytest.approx(e["held_rms_logN"], abs=1e-4)
+    assert r["bench"]["held_vs_net_stress"]["verdict"] == "better"
+
+
+@pytest.mark.parametrize("name", ["es", "ys-lin", "ys-sat"])
+def test_refit_reaches_stored_optimum(name):
+    """Full maximum-likelihood refit on the FIT ids (each < 10 s) reproduces the AIC and stays off every bound."""
+    r = M.fit(name)
+    assert r["aic"] == pytest.approx(EXP[name]["aic"], abs=0.05)
+    assert not r["on_bound"]
+
+
+@pytest.mark.slow
+def test_refit_fitted_cap():
+    r = M.fit("ys-sat-fit")
+    assert r["aic"] == pytest.approx(EXP["ys-sat-fit"]["aic"], abs=0.05)
+    assert not r["on_bound"]
+
+
+def test_wall_and_saturation():
+    """Admissibility: a crack plus L0/2 reaching the 6 mm YS half-ligament is infinite F; the saturating map tends to a0 + a_cap."""
+    fd = M.fields("YS2025")
+    assert M.F_ys(fd, "V_r0.15", 5.8, 1.0, 0.0) == float("inf")
+    p = dict(a0=0.4, kap=4.46)
+    assert M.a_sat(M.A_CAP)(p, 50.0) == pytest.approx(0.4 + M.A_CAP)
+    assert M.a_sat(M.A_CAP)(p, 1e-4) == pytest.approx(0.4 + 4.46e-4, rel=1e-3)
