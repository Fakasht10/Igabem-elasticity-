+"""Crack-in-elastic-field fatigue model on the PLA fatigue benchmark (calibration/pla_fatigue.py).
+
+One damage law for every row, one structural map F per specimen (see README.md for the equations):
+
+    ln c  = k (ln sD - ln(S F) - gam ln((1 - R)/2))          S = sigma_max (net nominal), Walker R correction
+    ln N  ~ Normal(ln c, sZ); run-outs right-censored          likelihood over the split's FIT ids only
+
+F is the amplification a crack of depth a feels at a process-zone distance L0/2 = 0.2 mm ahead of its tip when it sits in
+the uncracked IgBEM field of the specimen (unit net stress). Fields are the benchmark's stored IgBEM extracts.
+
+Models (MODELS below): "es" ES2020 finite-width crack (one constant a0); "ys-lin" YS 3D baseline a = a0 + kap d_V;
+"ys-sat" YS saturating defect a = a0 + a_cap (1 - exp(-kap d_V / a_cap)), a_cap = 2.1 mm a priori; "ys-sat-fit" a_cap fitted.
+"""
+
+from __future__ import annotations
+
+import gzip
+import json
+import math
+from collections.abc import Callable
+from functools import lru_cache
+
+import numpy as np
+from scipy.optimize import minimize
+from scipy.stats import norm
+
+from calibration import pla_fatigue as B
+
+EXTRACTS = B.DATA / "fields" / "extracts"
+L0 = 0.4  # process-zone length (mm), fixed: F is read at L0/2 ahead of the crack tip
+A_CAP = 2.1  # mm, a priori: YS half-thickness 2.5 minus the 0.4 mm shell = infill core a void-seeded crack can occupy
+Z90 = 1.2815515655446004  # standard-normal P90
+_GL_X, _GL_W = np.polynomial.legendre.leggauss(128)
+_TH, _WT = (
+    (_GL_X + 1) * math.pi / 4,
+    _GL_W / 2,
+)  # theta in (0, pi/2), weights summing to 1
+
+
+@lru_cache
+def fields(source: str) -> dict:
+    """Bisector sigma_1 profiles (d mm from the root, K = sigma_1 / net stress) and ligament half-width b (mm).
+
+    ES: mean over the 5 thickness stations of ES_igabem_bisector_profiles (V, U r1, U r3; the ES plain bar is uniform).
+    YS: mid-plane station z = 2.5 mm of YS_igabem_fields_3d, including the plain hourglass (Kt 1.217, not 1).
+    """
+    if source == "ES2020":
+        js = json.load(gzip.open(EXTRACTS / "ES_igabem_bisector_profiles.json.gz"))[
+            "profiles"
+        ]
+        nm = {"sharp": "V_r0.15", "intermediate": "U_r1", "blunt": "U_r3"}
+        prof = {
+            nm[k]: (np.asarray(v["d"]), np.asarray(v["s1"]).mean(0))
+            for k, v in js.items()
+        }
+        return {"prof": prof, "b": 2.997}  # net 6 mm
+    js = json.load(gzip.open(EXTRACTS / "YS_igabem_fields_3d.json.gz"))["specimens"]
+    prof = {}
+    for k, v in js.items():
+        bi = v["bisector"]
+        z = np.asarray(bi["z"])
+        prof[k] = (
+            np.asarray(bi["d"]),
+            np.asarray(bi["s1"])[int(np.argmin(abs(z - 2.5)))],
+        )
+    return {"prof": prof, "b": 6.0}  # net 12 mm
+
+
+def K(fd: dict, g: str, x: float | np.ndarray) -> np.ndarray:
+    """Uncracked field at depth x, clipped at the ligament half-width (never mirrored)."""
+    d, s = fd["prof"][g]
+    return np.interp(np.clip(np.asarray(x, float), 0.0, fd["b"]), d, s)
+
+
+def wf_mean(fd: dict, g: str, a: float) -> float:
+    """(2/pi) int_0^{pi/2} K(a sin th) dth: weight-function average of the field over the crack (128-pt Gauss)."""
+    return float(K(fd, g, a * np.sin(_TH)) @ _WT)
+
+
+def westergaard(a: float, r: float) -> float:
+    """Amplification of a remote stress at distance r ahead of a crack of half-length a."""
+    return (a + r) / math.sqrt(r * (2 * a + r))
+
+
+def f_sent(al: float) -> float:
+    """Single-edge crack in a strip under tension, a/W = al (Tada 2.10, error < 0.5 % for al <= 0.6)."""
+    al = min(al, 0.9)
+    return 1.12 - 0.231 * al + 10.55 * al**2 - 21.72 * al**3 + 30.39 * al**4
+
+
+def F_es(fd: dict, g: str, a0: float) -> float:
+    """ES finite-width crack: edge crack a0 in the plain strip (W 3 mm per side) or in the notch field (net W 6 mm)."""
+    if g == "plain":
+        return f_sent(a0 / 3.0) / 1.12
+    return wf_mean(fd, g, a0) * f_sent(a0 / 6.0) / 1.12
+
+
+def F_ys(fd: dict, g: str, a: float, phi: float, n: float) -> float:
+    """YS crack superposed on the local field; inadmissible (inf) once crack + L0/2 reaches the ligament half-width."""
+    r = L0 / 2
+    if a + r >= fd["b"]:
+        return math.inf
+    return phi**-n * (
+        float(K(fd, g, a + r)) + (westergaard(a, r) - 1) * wf_mean(fd, g, a)
+    )
+
+
+def a_lin(p: dict, dv: float) -> float:
+    """Linear equivalent defect: a = a0 + kap d_V."""
+    return p["a0"] + p["kap"] * dv
+
+
+def a_sat(cap: float | None) -> Callable[[dict, float], float]:
+    """Saturating defect a = a0 + a_cap (1 - exp(-kap d_V / a_cap)); cap None -> a_cap is the parameter acap."""
+
+    def f(p: dict, dv: float) -> float:
+        c = cap if cap else p["acap"]
+        return p["a0"] + c * (1 - math.exp(-p["kap"] * dv / c))
+
+    return f
+
+
+Y_STARTS = [[0.5, 3.0, 0.7], [0.05, 8.0, 0.7], [1.5, 1.0, 0.7]]  # a0, kap, n
+MODELS = {
+    "es": dict(
+        source="ES2020",
+        extra=["a0"],
+        starts=[[0.3], [1.0], [1.8], [2.4]],
+        bounds=dict(a0=(1e-3, 2.9)),
+    ),
+    "ys-lin": dict(
+        source="YS2025",
+        extra=["a0", "kap", "n"],
+        starts=Y_STARTS,
+        amap=a_lin,
+        bounds=dict(a0=(0, 5.5), kap=(0, 30), n=(0, 5)),
+    ),
+    "ys-sat": dict(
+        source="YS2025",
+        extra=["a0", "kap", "n"],
+        starts=Y_STARTS,
+        amap=a_sat(A_CAP),
+        bounds=dict(a0=(0, 5.5), kap=(0, 60), n=(0, 5)),
+    ),
+    "ys-sat-fit": dict(
+        source="YS2025",
+        extra=["a0", "kap", "n", "acap"],
+        amap=a_sat(None),
+        starts=[s + [c] for s in Y_STARTS for c in (1.0, 2.5, 4.0)],
+        bounds=dict(a0=(0, 5.5), kap=(0, 60), n=(0, 5), acap=(0.05, 5.8)),
+    ),
+}
+CORE = ["lnsD", "k", "gam", "lnsZ"]
+
+
+class Data:
+    """Rows of one paper split as arrays; geometry key g = specimen_type."""
+
+    def __init__(self, source: str) -> None:
+        sp = B.split("paper", source)
+        by = {r["specimen_id"]: r for r in B.load()}
+        self.ids = sp["fit"] + sp["held"]
+        rr = [by[i] for i in self.ids]
+        self.source = source
+        self.g = np.array([r["specimen_type"] for r in rr])
+        self.R = np.array([r["R"] for r in rr])
+        self.S = np.array([r["sigma_max_MPa"] for r in rr])
+        self.lnN = np.log([r["N_f"] for r in rr])
+        self.ro = np.array([r["runout"] for r in rr])
+        self.dv = np.array([r["d_v_mm"] or 0.0 for r in rr])  # 100 % in-fill: no void
+        self.phi = np.array([r["infill_pct"] / 100.0 for r in rr])
+        fit = set(sp["fit"])
+        self.fit = np.array([i in fit for i in self.ids])
+        keys = list(zip(self.g, self.dv, self.phi, strict=True))
+        self.ukeys = sorted(set(keys))
+        self.inv = np.array([self.ukeys.index(k) for k in keys])
+
+
+def F_rows(m: dict, d: Data, p: dict) -> np.ndarray:
+    """F for every row (evaluated once per unique geometry, void size, infill)."""
+    fd = fields(d.source)
+    if d.source == "ES2020":
+        u = [F_es(fd, g, p["a0"]) for g, _, _ in d.ukeys]
+    else:
+        u = [F_ys(fd, g, m["amap"](p, dv), ph, p["n"]) for g, dv, ph in d.ukeys]
+    return np.asarray(u)[d.inv]
+
+
+def lnc(d: Data, p: dict, F: np.ndarray) -> np.ndarray:
+    """Median log-life of every row."""
+    return p["k"] * (p["lnsD"] - np.log(d.S * F) - p["gam"] * np.log((1 - d.R) / 2))
+
+
+def fit(name: str, d: Data | None = None) -> dict:
+    """Maximum likelihood on the FIT ids (two-stage Nelder-Mead from every start x 2 core starts)."""
+    m = MODELS[name]
+    d = d or Data(m["source"])
+    names = CORE + m["extra"]
+
+    def unpack(x: np.ndarray) -> dict:
+        return {k: float(v) for k, v in zip(names, x, strict=True)}
+
+    def nll(x: np.ndarray) -> float:
+        p = unpack(x)
+        if not (1 < p["k"] < 40 and 0 <= p["gam"] <= 1 and -4 < p["lnsZ"] < 1.5):
+            return 1e12
+        if any(not lo <= p[k] <= hi for k, (lo, hi) in m["bounds"].items()):
+            return 1e12
+        c = lnc(d, p, F_rows(m, d, p))
+        if not np.all(
+            np.isfinite(c[d.fit])
+        ):  # admissibility wall, tested on fitted rows only
+            return 1e12
+        z = (d.lnN - c) / math.exp(p["lnsZ"])
+        ll = np.where(d.ro, norm.logsf(z), norm.logpdf(z) - p["lnsZ"])
+        return -float(ll[d.fit].sum())
+
+    base = [math.log(60 if d.source == "ES2020" else 20), 5.0, 0.45, math.log(1.3)]
+    best = None
+    for s in m["starts"]:
+        for b in (base, [base[0] + 0.7, 4.0, 0.3, 0.0]):
+            o = minimize(
+                nll,
+                np.array(b + s),
+                method="Nelder-Mead",
+                options=dict(maxiter=8000, xatol=1e-5, fatol=1e-7),
+            )
+            o = minimize(
+                nll,
+                o.x,
+                method="Nelder-Mead",
+                options=dict(maxiter=8000, xatol=1e-6, fatol=1e-9),
+            )
+            if best is None or o.fun < best.fun:
+                best = o
+    p = unpack(best.x)
+    on_bound = [
+        k
+        for k, (lo, hi) in m["bounds"].items()
+        if min(abs(p[k] - lo), abs(p[k] - hi)) < 1e-3 * max(1, abs(hi))
+    ]
+    return dict(
+        model=name,
+        par=p,
+        nll=float(best.fun),
+        aic=float(2 * best.fun + 2 * len(names)),
+        on_bound=on_bound,
+    )
+
+
+def predict(name: str, p: dict, d: Data | None = None) -> dict:
+    """Benchmark inputs: median strength at each row's life, its P10-P90 interval, and the median life at the applied S."""
+    m = MODELS[name]
+    d = d or Data(m["source"])
+    F = F_rows(m, d, p)
+    c = lnc(d, p, F)
+    rs = (c - d.lnN) / p["k"]  # ln(S_pred / S)
+    hw = Z90 * math.exp(p["lnsZ"]) / p["k"]
+    S = d.S * np.exp(rs)
+    out = dict(pred={}, interval={}, pred_life={}, F=F, lnc=c, d=d)
+    for j, i in enumerate(d.ids):
+        if np.isfinite(S[j]):
+            out["pred"][i] = float(S[j])
+            out["interval"][i] = (
+                float(S[j] * math.exp(-hw)),
+                float(S[j] * math.exp(hw)),
+            )
+            out["pred_life"][i] = float(math.exp(c[j]))
+    return out
+
+
+def own_stats(pr: dict, p: dict) -> dict:
+    """Life-residual statistics, log10(N_exp / N_pred), on failures, fit and held.
+
+    rms, bias, tilt vs N_exp and vs N_pred, P10-P90 coverage in life; plus the YS U r1 - U r3
+    mean life residual (the open deficiency).
+    """
+    d, c = pr["d"], pr["lnc"]
+    ep, x = c / math.log(10), d.lnN / math.log(10)
+    r = x - ep
+    sz = math.exp(p["lnsZ"]) / math.log(10)
+    out = {}
+    for part, msk in (("fit", d.fit & ~d.ro), ("held", ~d.fit & ~d.ro)):
+        out[part] = dict(
+            n=int(msk.sum()),
+            rms_logN=float(np.sqrt(np.mean(r[msk] ** 2))),
+            bias_logN=float(r[msk].mean()),
+            tilt_vs_Nexp=float(np.polyfit(x[msk], r[msk], 1)[0]),
+            tilt_vs_Npred=float(np.polyfit(ep[msk], r[msk], 1)[0]),
+            coverage80=float(np.mean(np.abs(r[msk]) <= Z90 * sz)),
+        )
+    if d.source == "YS2025":
+        u1, u3 = (d.g == "U_r1") & ~d.ro, (d.g == "U_r3") & ~d.ro
+        out["U1_minus_U3_logN"] = float(r[u1].mean() - r[u3].mean())
+    return out
+
+
+def run(name: str, par: dict | None = None) -> dict:
+    """Fit (unless par given) and score with the benchmark scorer. Returns everything needed for the README table."""
+    m = MODELS[name]
+    d = Data(m["source"])
+    res = fit(name, d) if par is None else dict(model=name, par=par)
+    pr = predict(name, res["par"], d)
+    rep = B.score(
+        pr["pred"],
+        "paper",
+        m["source"],
+        interval=pr["interval"],
+        pred_life=pr["pred_life"],
+    )
+    res.update(own=own_stats(pr, res["par"]), bench=rep)
+    if d.source == "YS2025":
+        a = [m["amap"](res["par"], v) for v in (d.dv[d.fit].max(), d.dv.max())]
+        res.update(
+            a_max_fit=a[0],
+            a_max_all=a[1],
+            wall_gap=fields(d.source)["b"] - L0 / 2 - a[1],
+        )
+    return res
